# Konfigurasi web Firebase (aman dipakai di browser, tetapi tetap jangan di-commit)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Pakai emulator saat development lokal (true/false)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Admin SDK (server only) — isi dari Service Account, JANGAN pernah diberi awalan NEXT_PUBLIC_
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Email (pisahkan dengan koma) yang otomatis menjadi super admin saat pertama kali login,
# bila akunnya belum punya role. Akun tetap harus dibuat dulu di Firebase Authentication.
SUPER_ADMIN_EMAILS=

# Cloudinary (server only, untuk signed upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
